# Copy this file to .env and fill in the keys for whichever provider(s) you use.

# --- Ensemble models ---
# Comma-separated "<provider>:<model_id>" list. Only "groq" and "gemini" are
# built in (see config.PROVIDERS); prefix determines which one is used. With
# no recognised prefix, "groq" is assumed.
LLM_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b

# Only the key(s) for providers you actually reference in LLM_MODELS/VISION_MODEL
# are required.
GROQ_API_KEY=gsk_dSrqznxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AQ.Abxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A submission only counts as scored if at least this many models return a
# usable JSON result.
MIN_SUCCESSFUL_MODELS=2

# Max number of models queried concurrently per submission.
LLM_MAX_CONCURRENT=1

# Reasoning effort for gpt-oss-family models ("low"/"medium"/"high", or empty
# to omit). Keeps hidden thinking-token cost and latency down.
REASONING_EFFORT=low

# Ceiling on the model's reply (reasoning + JSON), not on the prompt.
#MAX_TOKENS=2000

# Model sampling temperature.
TEMPERATURE=0

# Per-request timeout in seconds.
REQUEST_TIMEOUT_SECONDS=180

# Max *not-yet-scored* submissions processed per run.
NUMBER_OF_ASSIGNMENT=500

# --- Reference files sent with every request ---
# Authoritative regulation text (so models don't fall back on another
# country's privacy law).
PDPA_PATH=PDPA.md
# Case study text given to candidates, kept separate from prompt.md so the
# rubric and the case facts can be edited independently.
CASE_STUDY_PATH=case_study.md

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- PDF diagram/chart handling ---
# "off" (default) - text/tables only. "describe" - rasterize pages that look
# like they contain a diagram/chart and have VISION_MODEL describe them.
PDF_IMAGE_HANDLING=off
# "<provider>:<model_id>" of a vision-capable model. Required when
# PDF_IMAGE_HANDLING=describe (Groq currently has no production vision model -
# use e.g. a Gemini Flash-Lite model here).
#VISION_MODEL=gemini:gemini-2.0-flash-lite

# Safety cap: at most this many pages per PDF get a vision call.
PDF_IMAGE_MAX_PAGES_PER_DOC=5
# DPI used when rasterizing a flagged page for the vision model.
PDF_IMAGE_DPI=150
# A page with at least this many vector shapes (rects+lines+curves) is
# treated as likely holding a vector-drawn chart/flowchart.
PDF_VECTOR_SHAPE_THRESHOLD=8
# A page with fewer extracted characters than this AND at least one vector
# shape is treated as "mostly a diagram with little caption text".
PDF_SPARSE_TEXT_CHARS=40

# --- Ensemble disagreement detection ---
# Flag a submission for manual review when the max-min spread across models
# exceeds these thresholds (per-criterion / on the total).
DISAGREEMENT_SECTION_THRESHOLD=5.0
DISAGREEMENT_TOTAL_THRESHOLD=15.0

# --- Sharding (optional) ---
# Lets several people split one submission folder and run independently, each
# under their own API key/account. Leave SHARD_COUNT=1 to process everything
# in one run. See README "Splitting Work Across Multiple People".
SHARD_INDEX=0
SHARD_COUNT=1
